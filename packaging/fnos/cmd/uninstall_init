#!/bin/bash
set -u

log_error() {
  printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE:-/tmp/nginx-web-uninstall.log}"
}

clear_directory() {
  local target="${1:-}"
  case "$target" in
    ""|/|.) return 1 ;;
  esac
  [ ! -d "$target" ] || find "$target" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
}

preserve_app_data() {
  if [ -z "${TRIM_PKGVAR:-}" ] || [ -z "${TRIM_PKGETC:-}" ]; then
    log_error "无法定位应用数据目录，已中止卸载以避免配置丢失。"
    return 1
  fi

  local preserved_root="${TRIM_PKGVAR}/.uninstall-preserved"
  clear_directory "$preserved_root" || return 1
  mkdir -p "${preserved_root}/etc" || return 1

  if [ -d "$TRIM_PKGETC" ]; then
    cp -a "${TRIM_PKGETC}/." "${preserved_root}/etc/" || {
      log_error "保留应用配置失败，已中止卸载。"
      return 1
    }
  fi

  if [ -n "${TRIM_PKGHOME:-}" ] && [ -d "$TRIM_PKGHOME" ]; then
    mkdir -p "${preserved_root}/home" || return 1
    cp -a "${TRIM_PKGHOME}/." "${preserved_root}/home/" || {
      log_error "保留应用 Home 数据失败，已中止卸载。"
      return 1
    }
  fi
}

delete_app_data() {
  if [ -z "${TRIM_PKGVAR:-}" ] || [ -z "${TRIM_PKGETC:-}" ]; then
    log_error "无法定位应用数据目录，已中止卸载以避免误删。"
    return 1
  fi

  local target
  for target in "${TRIM_PKGETC:-}" "${TRIM_PKGHOME:-}" "${TRIM_PKGVAR:-}"; do
    [ -z "$target" ] || clear_directory "$target" || {
      log_error "删除应用数据失败，已中止卸载。"
      return 1
    }
  done
}

case "${wizard_delete_data:-false}" in
  true) delete_app_data || exit 1 ;;
  *) preserve_app_data || exit 1 ;;
esac

exit 0
