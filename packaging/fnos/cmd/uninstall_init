#!/bin/bash
set -u

# The packaged permission helper enforces the selected runtime mode.
source "$(dirname "${BASH_SOURCE[0]}")/privilege.sh"
enter_package_user "$@"

log_error() {
  printf '%s\n' "$1" >&2
  printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE:-/tmp/nginx-web-uninstall.log}"
}

clear_directory() {
  local target="${1:-}"
  case "$target" in
    ""|/|.) return 1 ;;
  esac
  [ ! -d "$target" ] || find "$target" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
}

preserve_app_data() {
  if [ -z "${TRIM_PKGVAR:-}" ] || [ -z "${TRIM_PKGETC:-}" ]; then
    log_error "无法定位应用数据目录，已中止卸载以避免配置丢失。"
    return 1
  fi

  local preserved_root="${TRIM_PKGVAR}/.uninstall-preserved"
  local previous="${preserved_root}.previous" staging output
  # Recover an interrupted replacement before attempting another backup.
  if [ -e "$previous" ]; then
    if [ ! -e "$preserved_root" ]; then
      mv -- "$previous" "$preserved_root" || { log_error "无法恢复上次保留备份。"; return 1; }
    else
      log_error "发现未清理的上一份备份：$previous；已中止卸载以保护数据。"
      return 1
    fi
  fi
  staging=$(mktemp -d "${TRIM_PKGVAR}/.uninstall-preserved.new.XXXXXX") || {
    log_error "无法创建保留数据临时目录，旧备份未修改。"; return 1
  }
  if ! output=$({
    mkdir -p "$staging/etc" &&
    { [ ! -d "$TRIM_PKGETC" ] || cp -a "${TRIM_PKGETC}/." "$staging/etc/"; } &&
    { [ -z "${TRIM_PKGHOME:-}" ] || [ ! -d "$TRIM_PKGHOME" ] ||
      { mkdir -p "$staging/home" && cp -a "${TRIM_PKGHOME}/." "$staging/home/"; }; }
  } 2>&1); then
    log_error "保留应用数据失败，旧备份未修改：$output"
    rm -rf -- "$staging"
    return 1
  fi
  if [ -e "$preserved_root" ] || [ -L "$preserved_root" ]; then
    mv -- "$preserved_root" "$previous" || { log_error "无法暂存旧备份，新备份位于 $staging"; return 1; }
  fi
  if ! mv -- "$staging" "$preserved_root"; then
    [ ! -e "$previous" ] || mv -- "$previous" "$preserved_root"
    log_error "无法替换保留备份，新备份位于 $staging"
    return 1
  fi
  if [ -e "$previous" ] && ! rm -rf -- "$previous"; then
    log_error "新备份已完成，但旧备份清理失败：$previous"
    return 1
  fi
}

delete_app_data() {
  if [ -z "${TRIM_PKGVAR:-}" ] || [ -z "${TRIM_PKGETC:-}" ]; then
    log_error "无法定位应用数据目录，已中止卸载以避免误删。"
    return 1
  fi

  local target
  for target in "${TRIM_PKGETC:-}" "${TRIM_PKGHOME:-}" "${TRIM_PKGVAR:-}"; do
    [ -z "$target" ] || clear_directory "$target" || {
      log_error "删除应用数据失败，已中止卸载。"
      return 1
    }
  done
}

case "${wizard_delete_data:-false}" in
  true) delete_app_data || exit 1 ;;
  *) preserve_app_data || exit 1 ;;
esac

exit 0
