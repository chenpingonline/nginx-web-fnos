appname                    = nginx-web
version                   = @CORE_VERSION@
display_name               = nginx-web
desc                       = 专为 fnOS 打造的 Nginx 可视化管理工具，支持 HTTP(S) 反向代理、TCP/UDP 转发、SSL 证书、负载均衡、限流与运行分析。内置独立 Nginx，不修改飞牛系统 Nginx。<a href="https://github.com/chenpingonline/nginx-web-fnos/blob/master/docs/user-guide.md" target="_blank" rel="noopener noreferrer">查看使用手册</a>
maintainer                 = chenping
maintainer_url             = https://github.com/chenpingonline/nginx-web-fnos
distributor                = chenping
source                     = thirdparty
platform                   = x86
ctl_stop                   = true
checkport                  = false
disable_authorization_path = false
os_min_version             = 1.1.3100
desktop_uidir              = ui
desktop_applaunchname      = nginx-web.main
changelog                  = 总览和请求分析支持自定义代理配置，已有站点无需转换为表单。
micro_app                  = true
