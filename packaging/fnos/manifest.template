appname                    = nginx-web
version                   = @CORE_VERSION@
display_name               = nginx-web
desc                       = nginx-web 是一款 Nginx 可视化管理工具，可集中配置反向代理、管理证书并监控服务运行状态。<br>• <strong>HTTP/HTTPS 反向代理</strong>：按域名或路径将请求转发到后端服务。<br>• <strong>TCP/UDP 转发</strong>：为 SSH、数据库或游戏服务配置端口转发。<br>• <strong>SSL/TLS 证书</strong>：导入已有证书，或通过 ACME 自动申请和续期。<br>• <strong>负载均衡与限流</strong>：按权重分配流量，限制请求速率或并发连接数。<br>• <strong>配置管理</strong>：通过表单或自定义配置编辑规则，校验后平滑重载。<br>• <strong>运行分析</strong>：查看活动连接数和访问日志，按规则跟踪请求速率与错误率。
maintainer                 = chenping
maintainer_url             = https://github.com/chenpingonline/nginx-web-fnos
distributor                = chenping
source                     = thirdparty
platform                   = x86
ctl_stop                   = true
checkport                  = false
disable_authorization_path = false
os_min_version             = 1.1.3100
desktop_uidir              = ui
desktop_applaunchname      = nginx-web.main
changelog                  = 1. <strong>卸载与重装</strong>：修复选择「保留数据」后再次卸载可能覆盖原备份的问题。重装时若原配置未通过校验，可进入管理页修复后手动应用。<br>2. <strong>HTTP(S) 代理规则</strong>：自定义监听地址默认收起，已指定 IP 的规则会自动展开。列表只显示根路径 / 的转发地址或静态目录。<br>3. <strong>按钮文字</strong>：调整亮色和暗色主题下可点击操作按钮的文字颜色，让可用和禁用状态更容易区分。
micro_app                  = true
